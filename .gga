# Gentleman Guardian Angel Configuration — CivicTech Peru
# AI Provider: DeepSeek V4 Flash via direct API

# AI Provider for code review
PROVIDER="codex"

# File patterns to review (Rust + TypeScript monorepo)
FILE_PATTERNS="*.rs,*.ts,*.tsx,*.js,*.jsx,*.mjs,*.cjs,*.yml,*.yaml,*.json,*.toml,*.sh,*.md"

# Patterns to exclude
EXCLUDE_PATTERNS="*.test.rs,*.spec.ts,*.test.ts,*.spec.tsx,*.test.tsx,*.d.ts,Cargo.lock,pnpm-lock.yaml,*.snap,*.generated.*,node_modules/*,dist/*,.next/*,target/*"

# Rules file
RULES_FILE="AGENTS.md"

# Strict mode: fail if AI response is ambiguous
STRICT_MODE="true"

# Timeout: 180 seconds for Rust compilation + review
TIMEOUT="180"

# Base branch for --pr-mode
PR_BASE_BRANCH="main"
