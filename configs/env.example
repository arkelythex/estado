# CivicTech Peru (estado) — Local development environment template
# Copy to .env and fill required secrets locally (never commit .env)

# Database
POSTGRES_USER=postgres
POSTGRES_DB=civictech
POSTGRES_PASSWORD=
DATABASE_URL=postgres://postgres:<POSTGRES_PASSWORD>@localhost:5432/civictech?sslmode=disable

# Rust Critical Engine (internal HTTP service)
ENGINE_BIND_ADDR=127.0.0.1:8090
ENGINE_URL=http://127.0.0.1:8090
ENGINE_INTERNAL_TOKEN=

# Go Backend API
API_BIND_ADDR=0.0.0.0:8080
DEMO_EXPENSES_CSV_PATH=fixtures/demo_expenses.csv

# Auth (disabled | dev_static | oidc_jwks)
AUTH_MODE=dev_static
AUTH_DEV_ADMIN_TOKEN=
AUTH_DEV_MODERATOR_TOKEN=

# S3 / MinIO (SSE-S3 encryption at rest enabled on evidence bucket)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=
MINIO_KMS_SECRET_KEY=
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=evidence
S3_ACCESS_KEY=minio
S3_SECRET_KEY=

# Keycloak & Grafana
KEYCLOAK_ADMIN=keycloak_admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_PASSWORD=
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=

# Frontends (Bun + TanStack Start)
# apps/web runs on :3000, apps/admin runs on :3001, Grafana on :3002
VITE_API_URL=http://localhost:8080
